import random
import turtle

# =====================================
# 最初に自由に変更してよい設定
# =====================================

PLAYER_COLOR = "blue"
TREASURE_COLOR = "gold"
BACKGROUND_COLOR = "white"

MOVE = 25
GOAL = 5

# =====================================
# ゲームを完成させる3つの穴
# =====================================

SIDE_MOVE = 0       # 穴1：MOVEにすると左右に動く
HIT_DISTANCE = 0    # 穴2：30にするとお宝を取れる
POINT = 0           # 穴3：1にすると得点が増える

# =====================================
# 画面を作る
# =====================================

screen = turtle.Screen()
screen.setup(640, 640)
screen.title("Python Treasure Game")
screen.bgcolor(BACKGROUND_COLOR)

LIMIT = 280

# プレイヤー
player = turtle.Turtle()
player.shape("turtle")
player.color(PLAYER_COLOR)
player.penup()

# お宝
treasure = turtle.Turtle()
treasure.shape("circle")
treasure.color(TREASURE_COLOR)
treasure.penup()
treasure.goto(150, 100)

# 得点表示
score_writer = turtle.Turtle()
score_writer.hideturtle()
score_writer.penup()
score_writer.goto(0, 270)

# クリア表示
message_writer = turtle.Turtle()
message_writer.hideturtle()
message_writer.penup()

score = 0
playing = True


def show_score():
    score_writer.clear()
    score_writer.write(
        f"SCORE: {score} / {GOAL}",
        align="center",
        font=("Arial", 18, "bold"),
    )


# 上下移動は最初から完成済み
def move_up():
    if playing:
        new_y = min(LIMIT, player.ycor() + MOVE)
        player.sety(new_y)


def move_down():
    if playing:
        new_y = max(-LIMIT, player.ycor() - MOVE)
        player.sety(new_y)


# 左右移動はSIDE_MOVEを直すと動く
def move_right():
    if playing:
        new_x = min(LIMIT, player.xcor() + SIDE_MOVE)
        player.setx(new_x)


def move_left():
    if playing:
        new_x = max(-LIMIT, player.xcor() - SIDE_MOVE)
        player.setx(new_x)


def check_hit():
    global score
    global playing

    if not playing:
        return

    # お宝との距離が近ければ得点
    if player.distance(treasure) < HIT_DISTANCE:
        score = score + POINT
        show_score()

        treasure.goto(
            random.randint(-250, 250),
            random.randint(-250, 250),
        )

        if score >= GOAL:
            playing = False
            message_writer.write(
                "CLEAR!",
                align="center",
                font=("Arial", 36, "bold"),
            )
            return

    screen.ontimer(check_hit, 50)


screen.onkeypress(move_up, "Up")
screen.onkeypress(move_down, "Down")
screen.onkeypress(move_right, "Right")
screen.onkeypress(move_left, "Left")

screen.listen()
show_score()
check_hit()
screen.mainloop()
